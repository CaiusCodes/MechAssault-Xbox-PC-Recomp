// the executable's icon: resource 1, which every window class of the runtime loads (scripts/icon/make_icon.py draws it)
1 ICON "mechassault.ico"

// the version Windows shows in the file's properties (VERSION at the repository's root)
1 VERSIONINFO
FILEVERSION 0,6,2,0
PRODUCTVERSION 0,6,2,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MechAssault native PC version (unofficial)"
            VALUE "FileVersion", "0.6.2"
            VALUE "ProductName", "MechAssault PC"
            VALUE "ProductVersion", "0.6.2"
            VALUE "OriginalFilename", "MechAssault.exe"
            VALUE "InternalName", "MechAssault"
            VALUE "CompanyName", "MechAssault PC port (fan project)"
            VALUE "LegalCopyright", "Port code: open source (see licenses). MechAssault is a trademark of Microsoft."
            VALUE "Comments", "Runs your own MechAssault disc; builds the game code on this PC on first start."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
