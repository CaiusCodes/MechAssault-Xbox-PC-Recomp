// the executable's icon: resource 1, which every window class of the runtime loads (scripts/icon/make_icon.py draws it)
1 ICON "mechassault.ico"

// the version Windows shows in the file's properties (VERSION at the repository's root)
1 VERSIONINFO
FILEVERSION 0,5,1,0
PRODUCTVERSION 0,5,1,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MechAssault native PC version (unofficial)"
            VALUE "FileVersion", "0.5.1"
            VALUE "ProductName", "MechAssault PC"
            VALUE "ProductVersion", "0.5.1"
            VALUE "OriginalFilename", "MechAssault.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
