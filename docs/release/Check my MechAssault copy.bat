@echo off
rem Reads default.xbe of a MechAssault copy and writes what release it is (region, version, build date, fingerprints)
rem to MechAssault-copy-check.txt on the Desktop. Put this file in the folder with default.xbe and double-click it,
rem or double-click it anywhere and pick that folder. It only reads; nothing is changed or sent.
set "MA_HERE=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0'); iex $s.Substring($s.IndexOf('#PS'+'START'))"
pause
exit /b
#PSSTART
$ErrorActionPreference = 'Stop'
function Find-Xbe([string]$dir) {
    if (-not $dir -or -not (Test-Path -LiteralPath $dir)) { return $null }
    $x = Get-ChildItem -LiteralPath $dir -Filter 'default.xbe' -File -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($x) { return $x.FullName }
    $x = Get-ChildItem -LiteralPath $dir -Filter 'default.xbe' -File -Recurse -Depth 2 -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($x) { return $x.FullName }
    return $null
}
$xbe = Find-Xbe $env:MA_HERE
if (-not $xbe) {
    Add-Type -AssemblyName System.Windows.Forms
    $pick = New-Object System.Windows.Forms.FolderBrowserDialog
    $pick.Description = 'Choose the MechAssault game folder (the one with default.xbe in it)'
    if ($pick.ShowDialog() -ne 'OK') { Write-Host 'No folder chosen.'; return }
    $xbe = Find-Xbe $pick.SelectedPath
    if (-not $xbe) { Write-Host "No default.xbe in $($pick.SelectedPath)."; return }
}
$b = [IO.File]::ReadAllBytes($xbe)
function U32([int]$o) { if ($o -lt 0 -or $o + 4 -gt $b.Length) { return [uint32]0 }; return [BitConverter]::ToUInt32($b, $o) }
function Hex([byte[]]$h) { return (($h | ForEach-Object { $_.ToString('x2') }) -join '') }
$out = New-Object System.Collections.Generic.List[string]
$out.Add('MechAssault copy check, ' + (Get-Date -Format 'yyyy-MM-dd HH:mm'))
$out.Add('File: ' + $xbe)
$out.Add('Size: ' + $b.Length + ' bytes')
$sha = [Security.Cryptography.SHA1]::Create()
$out.Add('SHA-1: ' + (Hex $sha.ComputeHash($b)))
if ($b.Length -lt 0x180 -or [Text.Encoding]::ASCII.GetString($b, 0, 4) -ne 'XBEH') {
    $out.Add('Not an Xbox executable (no XBEH header).')
} else {
    $base = U32 0x104; $image = U32 0x10C; $cert = [int]((U32 0x118) - $base)
    $epoch = [DateTime]'1970-01-01'
    $out.Add('Built: ' + $epoch.AddSeconds((U32 0x114)).ToString('yyyy-MM-dd HH:mm') + ' UTC')
    $id = U32 ($cert + 8)
    $name = [Text.Encoding]::Unicode.GetString($b, $cert + 0xC, 80).Split([char]0)[0]
    $out.Add(('Title: {0} (title ID {1:X8})' -f $name, $id))
    $region = U32 ($cert + 0xA0)
    $parts = @()
    if ($region -band 1) { $parts += 'North America' }
    if ($region -band 2) { $parts += 'Japan' }
    if ($region -band 4) { $parts += 'Europe/rest of world' }
    if ($region -band 2147483648) { $parts += 'manufacturing' }
    $out.Add(('Region: {0:X8} ({1})' -f $region, ($parts -join ', ')))
    $out.Add(('Version: {0}, disc {1}' -f (U32 ($cert + 0xAC)), (U32 ($cert + 0xA8))))
    $out.Add(('Media flags: {0:X8}, ratings {1:X8}, certificate date {2}' -f (U32 ($cert + 0x9C)), (U32 ($cert + 0xA4)), $epoch.AddSeconds((U32 ($cert + 4))).ToString('yyyy-MM-dd')))
    $libs = @()
    $n = U32 0x160; $la = [int]((U32 0x164) - $base)
    for ($i = 0; $i -lt [Math]::Min($n, 32); $i++) {
        $o = $la + $i * 16
        $ln = [Text.Encoding]::ASCII.GetString($b, $o, 8).Trim([char]0)
        $libs += ('{0} {1}.{2}.{3}' -f $ln, [BitConverter]::ToUInt16($b, $o + 8), [BitConverter]::ToUInt16($b, $o + 10), [BitConverter]::ToUInt16($b, $o + 12))
    }
    $out.Add('Libraries: ' + ($libs -join ', '))
    # the game code's fingerprint, as the setup checks it (sdk/runtime/core/game_import.cpp XbeCodeSha1)
    function Decode([uint32]$v, [uint32]$retail, [uint32]$debug) { $r = $v -bxor $retail; if ($r -ge $base -and ($r - $base) -lt $image) { return [uint32]$r }; return [uint32]($v -bxor $debug) }
    $entry = Decode (U32 0x128) 2835109803 2491784523
    $thunk = Decode (U32 0x158) 1533886646 4021416274
    $code = [Security.Cryptography.SHA1]::Create()
    function Add32([uint32]$v) { $w = [BitConverter]::GetBytes($v); [void]$code.TransformBlock($w, 0, 4, $null, 0) }
    Add32 $base; Add32 $entry; Add32 $thunk
    $count = U32 0x11C; $hdr = [int]((U32 0x120) - $base)
    $secs = @()
    for ($i = 0; $i -lt $count; $i++) {
        $h = $hdr + $i * 0x38
        $flags = U32 $h; $va = U32 ($h + 4); $vsize = U32 ($h + 8); $raw = [int](U32 ($h + 12)); $rsize = [int](U32 ($h + 16))
        Add32 $flags; Add32 $va; Add32 $vsize; Add32 ([uint32]$rsize)
        if ($rsize -gt 0) { [void]$code.TransformBlock($b, $raw, $rsize, $null, 0) }
        $sname = [Text.Encoding]::ASCII.GetString($b, [int](U32 ($h + 0x14)) - $base, 12).Split([char]0)[0]
        $secs += ('{0} {1:X}+{2:X}' -f $sname, $va, $vsize)
    }
    [void]$code.TransformFinalBlock([byte[]]@(), 0, 0)
    $out.Add('Code fingerprint: ' + (Hex $code.Hash))
    $out.Add(('Entry {0:X8}, kernel thunk {1:X8}, base {2:X8}' -f $entry, $thunk, $base))
    $out.Add('Sections: ' + ($secs -join ', '))
    if (@('919910b4f6fe5ba6b169754088dc61b89e77e2c9') -contains (Hex $code.Hash)) {
        $out.Add('=> MechAssault (USA, Europe), the release this PC version supports (or a known patched copy of it).')
    } else {
        $out.Add('=> Different game code from MechAssault (USA, Europe): another release or a modified file.')
    }
}
# against MechAssault (USA, Europe): which 1 KB blocks of the file differ (SHA-1 of each block, first 8 bytes), and this copy's
# bytes in them, so a patched copy's changes can be found
$ref = ''
if ($b.Length -eq 3559424) {
    $diff = @()
    $blk = [Security.Cryptography.SHA1]::Create()
    for ($i = 0; $i * 1024 -lt $b.Length; $i++) {
        $len = [Math]::Min(1024, $b.Length - $i * 1024)
        $h = (Hex $blk.ComputeHash($b, $i * 1024, $len)).Substring(0, 16)
        if ($h -ne $ref.Substring($i * 16, 16)) { $diff += $i }
    }
    $out.Add('Blocks that differ from MechAssault (USA, Europe): ' + $diff.Count + ' of ' + [int][Math]::Ceiling($b.Length / 1024))
    foreach ($i in ($diff | Select-Object -First 24)) {
        $o = $i * 1024
        $len = [Math]::Min(1024, $b.Length - $o)
        $out.Add(('Block {0:X6}: {1}' -f $o, [BitConverter]::ToString($b, $o, $len).Replace('-', '')))
    }
} else {
    $out.Add('The file is not the size of MechAssault (USA, Europe), so it was not compared block by block.')
}
$dir = Split-Path -Parent $xbe
$files = Get-ChildItem -LiteralPath $dir -File -Recurse -ErrorAction SilentlyContinue
$out.Add(('Game folder: {0} files, {1} bytes' -f $files.Count, (($files | Measure-Object Length -Sum).Sum)))
$txt = Join-Path ([Environment]::GetFolderPath('Desktop')) 'MechAssault-copy-check.txt'
$out | Set-Content -LiteralPath $txt -Encoding UTF8
$out | ForEach-Object { Write-Host $_ }
Write-Host ''
Write-Host "Saved to $txt - send that file."
